# Sistema
.DS_Store
Thumbs.db
*.log

# Ambiente e credenciais privadas
# O ficheiro includes/config.php contém código de configuração e deve ser versionável.
# Segredos reais ficam no .env, que não deve ser enviado para o Git.
.env
.env.*
!.env.example
!.env.production.example
*.env


# Ficheiros locais privados opcionais (se forem usados)
/includes/config.local.php
/includes/config.private.php

# Ficheiros de configuração/segredos locais de API
/api/*config*.local.php
/api/*secret*.local.php

# Uploads e ficheiros gerados
assets/img/profile/*
assets/img/projects/*
assets/downloads/*.pdf
assets/img/testimonials/*
!assets/img/profile/.gitkeep
!assets/img/projects/.gitkeep
!assets/img/testimonials/.gitkeep

# CV (ficheiro pessoal, não versionar)
download/*.pdf

# Base de dados (nunca subir dumps com dados reais)
database/seeds.sql

# IDE
.vscode/
.idea/
*.swp
*.swo

# Cache PHP
*.cache
