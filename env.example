# Copiar para .env e preencher os valores próprios deste ambiente.
# Não guardar .env no Git e nunca publicar os segredos.

APP_ENV=development
BASE_URL=http://localhost/portfolio-jmbenga
ADMIN_PATH=/jm-panel

DB_HOST=localhost
DB_NAME=portfolio_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_LIFETIME=3600

# Chaves API — deixar vazias no exemplo; adicionar valores apenas no .env privado.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME="JMbenga Portfolio"

# Endereços IP dos proxies realmente confiáveis, separados por vírgula.
TRUSTED_PROXY_IPS=

# Geolocalização por IP via ipwho.is. Quando activa, o IP público é enviado ao serviço.
VISITOR_GEO_ENABLED=false
